{
  "name": "skytrace",
  "private": true,
  "description": "Open-source, non-commercial live flight tracker built on community ADS-B data.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build && turbo run size && pnpm --filter @skytrace/server test:load",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:refresh": "tsx scripts/fetch-static-data.ts",
    "prepare": "husky",
    "e2e": "pnpm --filter @skytrace/web e2e",
    "mcp": "pnpm --filter @skytrace/mcp build && pnpm --filter @skytrace/mcp start"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,html,css,scss,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "turbo": "2.11.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "3.2.7"
  }
}
