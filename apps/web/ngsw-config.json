{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/maplibre/**", "/**/*.(svg|png|webp|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "basemap",
      "urls": ["https://basemaps.cartocdn.com/**", "https://tiles.basemaps.cartocdn.com/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 3000, "maxAge": "7d" }
    },
    {
      "name": "static-api",
      "urls": ["/api/airport/**", "/api/route/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 200, "maxAge": "1h", "timeout": "4s" }
    }
  ]
}
